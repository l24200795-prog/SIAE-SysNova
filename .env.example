# =============================================================================
# SIAE · SYS NOVA (ITP) — Variables de entorno de ejemplo
# Copia este archivo:
#   - Desarrollo local del backend:  cp .env.example backend/.env
#   - Docker Compose:                cp .env.example .env
# NUNCA subas un .env real al repositorio (está en .gitignore).
#
# Aquí solo va configuración de INFRAESTRUCTURA. Los límites de negocio
# (asistencia mínima, tamaño máximo de archivo, créditos requeridos, folios)
# viven en la tabla PARAMETRO_SISTEMA (RIES-DIS-003).
# =============================================================================

# --- Aplicación --------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
# Orígenes permitidos por CORS, separados por coma
CORS_ORIGIN=http://localhost:5173
# Dominio aceptado en el correo de inicio de sesión (Tabla 40)
CORREO_DOMINIO_INSTITUCIONAL=pachuca.tecnm.mx

# --- MySQL 8.0 (InnoDB, driver mysql2) ---------------------------------------
# En Docker Compose usa el nombre del servicio (p. ej. DB_HOST=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=siae
DB_USER=siae_app
DB_PASSWORD=cambia_esta_contrasena
DB_CONNECTION_LIMIT=10
# Solo para el contenedor de MySQL (docker-compose)
MYSQL_ROOT_PASSWORD=cambia_esta_contrasena_root

# --- Sesión: JWT en cookie HttpOnly / Secure ---------------------------------
# Genera valores con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=reemplazar_por_cadena_aleatoria_de_al_menos_32_caracteres
JWT_EXPIRES_IN=2h
COOKIE_NAME=siae_session
COOKIE_SECRET=reemplazar_por_otra_cadena_aleatoria_de_32_caracteres
# Costo de BCrypt (mínimo 10, CA-008-1)
BCRYPT_COST=12

# --- SMTP (Nodemailer · recuperación de contraseña RF-008) --------------------
SMTP_HOST=smtp.ejemplo.edu.mx
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@pachuca.tecnm.mx
SMTP_PASSWORD=cambia_esta_contrasena_smtp
SMTP_FROM="SIAE ITP <no-reply@pachuca.tecnm.mx>"

# --- Archivos (Multer · MOD-004) ---------------------------------------------
# El tamaño máximo NO va aquí: se lee de PARAMETRO_SISTEMA.tamano_maximo_mb
UPLOADS_DIR=uploads

# --- Frontend (Vite) ---------------------------------------------------------
VITE_API_URL=http://localhost:3000/api/v1
